#!/usr/bin/env bash
# Host active identity for multi-claw credentials.
# Containers mount L0 directly and ignore this. See ~/workspace/AGENTS.md.
set -euo pipefail

CRED_ROOT="${CLAW_CREDENTIALS_ROOT:-$HOME/credentials}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() {
  cat <<'EOF'
Usage: claw-id [company|personal|status|init|env]

  company   Make company the host active identity (default work)
  personal  Make personal the host active identity
  status    Show active identity and link targets (default)
  init      Run credentials-init, retarget links, show status
  env       Print export lines for eval "$(claw-id env)"

Env:
  CLAW_CREDENTIALS_ROOT  override ~/credentials
EOF
}

ensure_tree() {
  if [[ ! -d "$CRED_ROOT/company" || ! -d "$CRED_ROOT/personal" ]]; then
    if command -v credentials-init >/dev/null 2>&1; then
      credentials-init >/dev/null
    else
      echo "claw-id: missing $CRED_ROOT layout; run credentials-init first" >&2
      exit 1
    fi
  fi
}

replace_with_symlink() {
  local target="$1"
  local linkpath="$2"
  if [[ -L "$linkpath" ]]; then
    ln -sfn "$target" "$linkpath"
    return 0
  fi
  if [[ -d "$linkpath" ]]; then
    if [[ -z "$(ls -A "$linkpath" 2>/dev/null)" ]]; then
      rmdir "$linkpath"
      ln -sfn "$target" "$linkpath"
      return 0
    fi
    echo "claw-id: $linkpath is a non-empty directory (not a symlink)." >&2
    echo "  Move contents into L0 under ~/credentials/<identity>/, then re-run." >&2
    echo "  Or: mv \"$linkpath\" \"${linkpath}.bak.$(date +%Y%m%d)\"" >&2
    return 1
  fi
  if [[ -e "$linkpath" ]]; then
    echo "claw-id: $linkpath exists and is not a symlink." >&2
    return 1
  fi
  ln -sfn "$target" "$linkpath"
}

retarget_links() {
  local id="$1"
  local l0="$CRED_ROOT/$id"

  ln -sfn "$id" "$CRED_ROOT/active"
  mkdir -p "$CONFIG_HOME"

  replace_with_symlink "$l0/notion/vibe-notion" "$CONFIG_HOME/vibe-notion"
  replace_with_symlink "$l0/notion/ntn" "$CONFIG_HOME/notion"
  replace_with_symlink "$l0/agent-messenger" "$CONFIG_HOME/agent-messenger"

  local envfile="$CRED_ROOT/.env.active"
  cat >"$envfile" <<EOF
# generated by claw-id — do not commit
export CLAW_IDENTITY=$id
export GOG_HOME="$l0/gogcli"
export GOG_KEYRING_BACKEND=file
export GOG_KEYRING_PASSWORD=
EOF
  chmod 600 "$envfile"
}

print_status() {
  ensure_tree
  local active
  active="$(readlink "$CRED_ROOT/active" 2>/dev/null || true)"
  if [[ -z "$active" ]]; then
    active="(unset)"
  fi

  echo "credentials root: $CRED_ROOT"
  echo "active identity:  $active"
  if [[ -f "$CRED_ROOT/.env.active" ]]; then
    echo "env file:         $CRED_ROOT/.env.active"
    grep -E '^(export )?(CLAW_IDENTITY|GOG_HOME)=' "$CRED_ROOT/.env.active" 2>/dev/null || true
  fi
  echo
  echo "L1 symlinks:"
  local p
  for p in \
    "$CONFIG_HOME/vibe-notion" \
    "$CONFIG_HOME/notion" \
    "$CONFIG_HOME/agent-messenger"
  do
    if [[ -L "$p" ]]; then
      echo "  $p -> $(readlink "$p")"
    elif [[ -e "$p" ]]; then
      echo "  $p (exists, not a symlink — migrate into L0 manually)"
    else
      echo "  $p (missing)"
    fi
  done
  echo
  echo "Tip: eval \"\$(claw-id env)\"  # export GOG_HOME for this shell"
}

emit_env() {
  ensure_tree
  local active
  active="$(readlink "$CRED_ROOT/active" 2>/dev/null || echo company)"
  local l0="$CRED_ROOT/$active"
  printf 'export CLAW_IDENTITY=%q\n' "$active"
  printf 'export GOG_HOME=%q\n' "$l0/gogcli"
  printf 'export GOG_KEYRING_BACKEND=file\n'
  printf 'export GOG_KEYRING_PASSWORD=\n'
}

cmd="${1:-status}"

case "$cmd" in
  -h|--help|help) usage ;;
  init)
    if command -v credentials-init >/dev/null 2>&1; then
      credentials-init
    else
      echo "credentials-init not on PATH" >&2
      exit 1
    fi
    if [[ ! -e "$CRED_ROOT/active" ]]; then
      retarget_links company
    else
      active="$(readlink "$CRED_ROOT/active")"
      retarget_links "$active"
    fi
    print_status
    ;;
  company|personal)
    ensure_tree
    if [[ ! -d "$CRED_ROOT/$cmd" ]]; then
      echo "claw-id: unknown identity dir: $CRED_ROOT/$cmd" >&2
      exit 1
    fi
    retarget_links "$cmd"
    echo "active identity -> $cmd"
    print_status
    echo
    echo "This shell still has old env. Run:  eval \"\$(claw-id env)\""
    ;;
  status) print_status ;;
  env) emit_env ;;
  *)
    echo "claw-id: unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
