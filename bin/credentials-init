#!/usr/bin/env bash
# Create/repair ~/credentials identity layout (no secrets written).
# Idempotent. See ~/workspace/AGENTS.md (fleet policy).
set -euo pipefail

CRED_ROOT="${CLAW_CREDENTIALS_ROOT:-$HOME/credentials}"

dirs=(
  company/gogcli
  company/notion/vibe-notion
  company/notion/ntn
  company/agent-messenger
  company/cafe24
  company/hwahae
  personal/gogcli
  personal/notion/vibe-notion
  personal/notion/ntn
  personal/agent-messenger
  shared/data
)

mkdir -p "$CRED_ROOT"
chmod 700 "$CRED_ROOT"

for rel in "${dirs[@]}"; do
  path="$CRED_ROOT/$rel"
  mkdir -p "$path"
  chmod 700 "$path" 2>/dev/null || true
done

# Identity roots
chmod 700 "$CRED_ROOT/company" "$CRED_ROOT/personal" "$CRED_ROOT/shared" 2>/dev/null || true

readme="$CRED_ROOT/README.md"
if [[ ! -f "$readme" ]]; then
  cat >"$readme" <<'EOF'
# credentials (host local — never git)

Canonical tool OAuth/session stores for claws. Policy:
`~/workspace/AGENTS.md` (from geonu/dot `workspace/AGENTS.md`).

```
company/   work identity (tandum)
personal/  private identity
shared/    explicit exceptions only (default empty)
active     symlink set by `claw-id` (host CLI only)
```

Rules:

- Real secrets live in the trees below — do not commit this directory.
- Claws mount paths under the matching identity, not all of `~/.config`.
- Host default paths (`~/.config/...`) are retargeted by `claw-id`.
- LLM/bot tokens stay in each claw's runtime secrets file, not here.

Bootstrap: `credentials-init` · switch host CLI identity: `claw-id company|personal`
EOF
  chmod 600 "$readme"
fi

# Default active identity if missing
if [[ ! -e "$CRED_ROOT/active" ]]; then
  ln -sfn company "$CRED_ROOT/active"
fi

echo "credentials ready: $CRED_ROOT"
echo "active -> $(readlink "$CRED_ROOT/active" 2>/dev/null || echo '?')"
ls -la "$CRED_ROOT"
