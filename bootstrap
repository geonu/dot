#!/usr/bin/env bash
#
# One-shot setup for a fresh macOS machine:
#   Homebrew -> Brewfile packages -> dotfile symlinks -> mise runtimes
#
# Safe to re-run; every step is idempotent.

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASEDIR}"

# 1. Homebrew
if ! command -v brew >/dev/null 2>&1; then
    echo "==> Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# 2. Packages
echo "==> Installing Homebrew packages from Brewfile"
brew bundle install --file="${BASEDIR}/Brewfile"

# 3. Dotfile symlinks + plugin-manager bootstrap
echo "==> Linking dotfiles"
"${BASEDIR}/install"

# 4. Runtimes
echo "==> Installing runtimes with mise"
mise install

echo "==> Done. Open a new shell to pick up the new configuration."
